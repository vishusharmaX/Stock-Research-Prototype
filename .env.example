# ==============================================================================
# Equity Intelligence — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RESEARCH PROVIDERS (Configure at least one or use deterministic benchmark fixtures)
# ------------------------------------------------------------------------------
# Parallel AI Deep Research Task API (https://platform.parallel.ai)
# Used for autonomous multi-step web exploration and synthesis.
PARALLEL_API_KEY=your_parallel_api_key_here

# OpenAI API Key (Alternative orchestrator provider: gpt-4o / o3-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Alternative orchestrator provider: claude-3-5-sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Preferred Provider Selection: 'auto' | 'parallel' | 'openai' | 'mock'
RESEARCH_PROVIDER_DEFAULT=auto

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE
# ------------------------------------------------------------------------------
# Supabase / PostgreSQL Connection String
# Example: postgres://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Project Credentials (optional client access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. TRANSCRIPT & SHARE SECURITY
# ------------------------------------------------------------------------------
# Secret salt for generating cryptographically secure read-only transcript tokens
TRANSCRIPT_SHARE_SECRET=change_this_to_a_random_32_character_string_for_production

# ------------------------------------------------------------------------------
# 4. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
